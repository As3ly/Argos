# Azure OpenAI
AZURE_API_KEY=
AZURE_ENDPOINT=
DEPLOYMENT=
API_VERSION=2024-10-21

# Proxy scrapers/Azure (optionnel : le proxy FRA reste la valeur par défaut)
# ARGOS_HTTP_PROXY=http://proxy:8080
# ARGOS_HTTPS_PROXY=http://proxy:8080

# EDF : laisser ce mode par défaut sans autorisation explicite.
ARGOS_EDF_CAPTCHA_MODE=fail

# À activer uniquement après autorisation explicite d'un administrateur EDF.
# La valeur du cookie doit venir d'une session officiellement prévalidée ; Argos
# ne résout pas le CAPTCHA et ne fabrique pas ce cookie.
ARGOS_EDF_SCRAPING_AUTHORIZED=false
ARGOS_EDF_AUTHORIZED_SESSION_COOKIE=

# Exemple autorisé :
# ARGOS_EDF_CAPTCHA_MODE=prevalidated_session
# ARGOS_EDF_SCRAPING_AUTHORIZED=true
# ARGOS_EDF_AUTHORIZED_SESSION_COOKIE=ASP.NET_SessionId=...; autre_cookie=...
